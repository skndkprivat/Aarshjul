Options -Indexes
DirectoryIndex index.html

# Kun hjemmesiden må vise årshjulet i en iframe, og kun egne scripts må køre
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'self' https://holbaek-cykelsport.dk https://www.holbaek-cykelsport.dk"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Skjul konfiguration og dokumentation
<FilesMatch "^(config\.php|config\.sample\.php|.*\.md)$">
  Require all denied
</FilesMatch>
